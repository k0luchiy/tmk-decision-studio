{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@app/contract": [
        "packages/contract/src/index.ts"
      ],
      "@app/core": [
        "packages/core/src/index.ts"
      ],
      "@app/data": [
        "packages/data/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/examples/**/*.ts"
  ]
}
