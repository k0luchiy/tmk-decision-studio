{
  "name": "radiohack4-cockpit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Decision Cockpit — estimation engine and modules (RadioHack 4.0)",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint packages scripts examples 2>/dev/null || eslint packages",
    "format:check": "prettier --check \"packages/**/*.{ts,json}\" \"*.{ts,js,json,md}\"",
    "data:manifest": "node scripts/build-manifest.mjs",
    "data:check": "node scripts/check-data.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "esbuild": "^0.21.5",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.8"
  }
}
