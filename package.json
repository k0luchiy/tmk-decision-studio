{
  "name": "radiohack4-cockpit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TMK Decision Studio — estimation engine, API and UI (RadioHack 4.0)",
  "license": "MIT",
  "workspaces": [
    "shared/*",
    "backend"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint shared scripts",
    "dev:api": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:frontend\"",
    "build:frontend": "npm --prefix frontend run build",
    "format:check": "prettier --check \"shared/**/*.{ts,json}\" \"*.{ts,js,json,md}\"",
    "data:manifest": "node scripts/build-manifest.mjs",
    "data:check": "node scripts/check-data.mjs",
    "calc": "node scripts/calc.mjs",
    "e2e": "node scripts/e2e.mjs",
    "report": "node scripts/test-report.mjs",
    "helpdesk:check": "node scripts/check-helpdesk.mjs",
    "intake:eval": "node scripts/intake-eval.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "concurrently": "^10.0.7",
    "esbuild": "^0.21.5",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.8"
  }
}
