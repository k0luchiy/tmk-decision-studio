# local — только клиентский расчёт (calc.js); api — backend POST /api/estimates.
# При ошибке API фронт автоматически падает обратно на локальный расчёт.
VITE_DATA_MODE=api

# Режим разбора брифа: off (только правила) | cache (Jev-кэш) | live (Jev онлайн).
# При live и ошибке фронт падает обратно на локальные правила.
VITE_INTAKE_MODE=cache

# Необязательно: абсолютный адрес API, если /api не проксируется Vite.
# VITE_API_URL=http://localhost:3001
