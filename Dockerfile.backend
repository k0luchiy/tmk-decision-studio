FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_NO_WARNINGS=1

COPY package.json package-lock.json ./
COPY shared ./shared
COPY backend ./backend

RUN npm ci

COPY tsconfig.base.json tsconfig.json ./
COPY data ./data
COPY scripts ./scripts

EXPOSE 3001
CMD ["npm", "--prefix", "backend", "run", "start"]
